{
  "name": "kide-demo",
  "private": true,
  "type": "module",
  "version": "0.26.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "rm -rf node_modules/.vite node_modules/.astro && astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "check": "astro check && eslint .",
    "test": "pnpm cms:generate && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:generate": "kide generate",
    "cms:admin": "kide admin",
    "cms:seed": "kide seed",
    "cms:reindex": "kide reindex",
    "cms:push": "pnpm cms:generate && kide push",
    "cms:describe": "kide describe",
    "cms:mcp": "kide mcp",
    "db:generate": "pnpm cms:generate && drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "verify:starters": "node scripts/verify-starters.mjs",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "predev": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<22||(v[0]===22&&v[1]<18)||v[0]>=23){console.error('\\n[kide] Cloudflare dev needs Node 22.18+ (22.x). You have '+process.version+'.\\n       Run: nvm install 22 && nvm use   (or use fnm/volta)\\n');process.exit(1)}\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.1.7",
    "@astrojs/react": "^6.0.1",
    "@kidecms/core": "^0.26.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^7.1.3",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.57.1",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.0.0",
    "wrangler": "^4.121.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "hono@<4.12.34": ">=4.12.34 <5.0.0",
      "ip-address@<10.2.1": ">=10.2.1 <11.0.0",
      "fast-uri@<3.1.5": ">=3.1.5 <4.0.0",
      "nanoid@<6.0.1": ">=6.0.1 <7.0.0",
      "js-yaml@<4.3.1": ">=4.3.1 <5.0.0",
      "svgo@<4.0.2": ">=4.0.2 <5.0.0",
      "postcss@<8.5.26": ">=8.5.26 <9.0.0",
      "esbuild@<0.28.1": ">=0.28.1",
      "@babel/core@<7.29.7": ">=7.29.7 <8.0.0",
      "@hono/node-server@<2.0.5": ">=2.0.5"
    }
  }
}
